{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "name": "start-sidekick",
            "type": "command",
            "command": "node ${extensionPath}/scripts/sidekick.ts session-start"
          }
        ]
      }
    ],
    "BeforeModel": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "send-to-sidekick",
            "type": "command",
            "command": "node ${extensionPath}/scripts/sidekick.ts before-model"
          }
        ]
      }
    ],
    "AfterModel": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "send-to-sidekick",
            "type": "command",
            "command": "node ${extensionPath}/scripts/sidekick.ts after-model"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "exit",
        "hooks": [
          {
            "name": "end-sidekick",
            "type": "command",
            "command": "node ${extensionPath}/scripts/sidekick.ts session-end"
          }
        ]
      }
    ]
  }
}
