{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "name": "start-sidekick",
            "type": "command",
            "command": "node ${extensionPath}/scripts/session-start.ts"
          }
        ]
      }
    ],
    "BeforeModel": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "send-to-sidekick",
            "type": "command",
            "command": "node ${extensionPath}/scripts/before-model.ts"
          }
        ]
      }
    ],
    "AfterModel": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "send-to-sidekick",
            "type": "command",
            "command": "node ${extensionPath}/scripts/after-model.ts"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "exit",
        "hooks": [
          {
            "name": "end-sidekick",
            "type": "command",
            "command": "node ${extensionPath}/scripts/session-end.ts"
          }
        ]
      }
    ]
  }
}
